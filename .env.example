# Exemplo de variáveis de ambiente
# Copie este arquivo para .env e preencha com seus valores

# API Keys
PERPLEXITY_API_KEY=sua_chave_perplexity_aqui

# Secret key para JWT (gere uma chave segura)
SECRET_KEY=sua_chave_secreta_muito_longa_e_aleatoria

# Database URL (OPCIONAL - se não definir, usa SQLite local automaticamente)
# 
# Para desenvolvimento local: não precisa configurar nada!
# O app usará SQLite (arquivo caloria.db) automaticamente.
#
# Para MySQL:
# DATABASE_URL=mysql+pymysql://usuario:senha@localhost:3306/caloria
#
# Para PostgreSQL (Digital Ocean - configurado automaticamente):
# DATABASE_URL=postgresql://usuario:senha@host:5432/database
