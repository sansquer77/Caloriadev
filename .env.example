# Exemplo de variáveis de ambiente
# Copie este arquivo para .env e preencha com seus valores

# API Keys
PERPLEXITY_API_KEY=sua_chave_perplexity_aqui
CALORIENINJAS_API_KEY=sua_chave_calorieninjas_aqui

# Secret key para JWT (gere uma chave segura)
SECRET_KEY=sua_chave_secreta_muito_longa_e_aleatoria

# Database URL (PostgreSQL para produção)
DATABASE_URL=postgresql://usuario:senha@host:5432/database

# Ou para desenvolvimento local com SQLite (padrão)
# DATABASE_URL=sqlite:///caloria.db
